{
  "kind": "dataspec-consumer-compatibility-suite",
  "schemaVersion": 1,
  "suiteVersion": "2026.07.p6-test-data",
  "minimumSupportedVersion": "0.1.0",
  "description": "Local golden payloads and adapter rules for DataSpec-owned consumers.",
  "compatibilityPolicy": "Additive optional fields are compatible; removing or renaming stable fields, descriptor metadata, safety fields, or documented output semantics is breaking.",
  "adapters": [
    {
      "id": "schema-registry",
      "required": true,
      "contractRefs": ["standard-test-data-package", "consumer-compatibility-suite"],
      "stableFields": ["kind", "schemaVersion", "contracts", "requiredContractIds"],
      "safety": { "readOnly": true, "requiresServer": false, "externalNetworkUsed": false }
    },
    {
      "id": "ai-context",
      "required": true,
      "contractRefs": ["ai-context-manifest", "ai-context-field-catalog", "ai-context-field-semantics", "ai-context-field-knowledge-cards", "ai-context-table-standards"],
      "stableFields": ["manifest", "schemaRegistry", "fieldCatalog", "tableStandards", "fieldKnowledgeCards", "fieldSemantics", "metrics"],
      "safety": { "readOnly": true, "requiresServer": false, "externalNetworkUsed": false }
    },
    {
      "id": "cli-json",
      "required": true,
      "contractRefs": ["dataspec-cli"],
      "stableFields": ["kind", "schemaVersion", "status", "diagnostics", "nextActions"],
      "safety": { "readOnly": true, "requiresServer": false, "externalNetworkUsed": false }
    },
    {
      "id": "mcp-descriptors",
      "required": true,
      "contractRefs": ["dataspec-mcp"],
      "stableFields": ["tools", "resources", "prompts", "safety"],
      "safety": { "readOnly": true, "requiresServer": false, "externalNetworkUsed": false }
    },
    {
      "id": "cli-mcp-contract-fixtures",
      "required": true,
      "contractRefs": ["cli-mcp-contract-fixtures"],
      "stableFields": ["cliCommands", "mcpTools", "mcpResources", "mcpPrompts"],
      "safety": { "readOnly": true, "requiresServer": false, "externalNetworkUsed": false }
    },
    {
      "id": "standard-test-data-package",
      "required": true,
      "contractRefs": ["standard-test-data-package"],
      "stableFields": [
        "kind", "schemaVersion", "projectId", "specHash", "generationParams",
        "sourceSummary", "sourceSummary.standardFieldCount", "sourceSummary.selectedFieldCount", "sourceSummary.enumValueCount",
        "testDataCases", "testDataCases.caseId", "testDataCases.fieldName", "testDataCases.caseType", "testDataCases.value", "testDataCases.expectedValidity", "testDataCases.reason", "testDataCases.sourceRefs", "testDataCases.requiresBusinessReview",
        "seedProfiles", "seedProfiles.profileId", "seedProfiles.format", "seedProfiles.dialect", "seedProfiles.content", "seedProfiles.fieldNames", "seedProfiles.sourceCaseIds", "seedProfiles.executable", "seedProfiles.requiresReview",
        "mockPayloads", "mockPayloads.payloadId", "mockPayloads.objectScenario", "mockPayloads.payload", "mockPayloads.sourceCaseIds",
        "coverageReport", "coverageReport.selectedFieldCount", "coverageReport.coveredFieldCount", "coverageReport.caseCount", "coverageReport.coverageLevel",
        "diagnostics",
        "safety", "safety.readOnly", "safety.writesProject", "safety.writesBusinessRepo", "safety.containsRealBusinessRows", "safety.externalNetworkUsed", "safety.externalLlmUsed",
        "nextActions"
      ],
      "safety": { "readOnly": true, "requiresServer": false, "externalNetworkUsed": false, "containsRealBusinessRows": false }
    }
  ],
  "breakingRules": [
    {
      "id": "stable-field-required",
      "severity": "ERROR",
      "description": "Removing, renaming, or changing the type of a stable field is breaking unless a migration note and schema version bump are present."
    },
    {
      "id": "safety-metadata-required",
      "severity": "ERROR",
      "description": "Read-only and sensitive-data safety metadata must remain present for AI-facing contracts."
    },
    {
      "id": "fixture-secret-free",
      "severity": "ERROR",
      "description": "Golden payloads and examples must not contain raw token, password, Authorization, JDBC URL, DSN, connection string, or private key values."
    }
  ],
  "goldenPayloads": [
    {
      "id": "standard-test-data-package-minimal",
      "adapterId": "standard-test-data-package",
      "contractId": "standard-test-data-package",
      "stableFields": [
        "kind", "schemaVersion", "projectId", "specHash", "generationParams",
        "sourceSummary", "sourceSummary.standardFieldCount", "sourceSummary.selectedFieldCount", "sourceSummary.enumValueCount",
        "testDataCases", "testDataCases.caseId", "testDataCases.fieldName", "testDataCases.caseType", "testDataCases.value", "testDataCases.expectedValidity", "testDataCases.reason", "testDataCases.sourceRefs", "testDataCases.requiresBusinessReview",
        "seedProfiles", "seedProfiles.profileId", "seedProfiles.format", "seedProfiles.dialect", "seedProfiles.content", "seedProfiles.fieldNames", "seedProfiles.sourceCaseIds", "seedProfiles.executable", "seedProfiles.requiresReview",
        "mockPayloads", "mockPayloads.payloadId", "mockPayloads.objectScenario", "mockPayloads.payload", "mockPayloads.sourceCaseIds",
        "coverageReport", "coverageReport.selectedFieldCount", "coverageReport.coveredFieldCount", "coverageReport.caseCount", "coverageReport.coverageLevel",
        "diagnostics",
        "safety", "safety.readOnly", "safety.writesProject", "safety.writesBusinessRepo", "safety.containsRealBusinessRows", "safety.externalNetworkUsed", "safety.externalLlmUsed",
        "nextActions"
      ],
      "payload": {
        "kind": "dataspec.standard-test-data-package",
        "schemaVersion": 1,
        "projectId": 1,
        "specHash": "sha256-demo",
        "generationParams": {
          "fieldNames": ["mobile_no"],
          "objectScenario": "standard",
          "maxFields": 1,
          "casesPerField": 3,
          "seedRowCount": 1,
          "dialect": "generic"
        },
        "sourceSummary": {
          "standardFieldCount": 1,
          "selectedFieldCount": 1,
          "enumValueCount": 0,
          "fallbackUsed": false,
          "selectedFields": ["mobile_no"],
          "sourceKinds": ["project-field"]
        },
        "testDataCases": [
          {
            "caseId": "mobile-no-valid",
            "fieldName": "mobile_no",
            "caseType": "VALID",
            "value": "13800138000",
            "expectedValidity": true,
            "reason": "synthetic phone example",
            "sourceRefs": ["field:100"],
            "requiresBusinessReview": false
          }
        ],
        "seedProfiles": [
          {
            "profileId": "seed-json",
            "format": "JSON",
            "dialect": "generic",
            "content": "[{\"mobile_no\":\"13800138000\"}]",
            "fieldNames": ["mobile_no"],
            "sourceCaseIds": ["mobile-no-valid"],
            "executable": false,
            "requiresReview": true
          }
        ],
        "mockPayloads": [
          {
            "payloadId": "mock-standard",
            "objectScenario": "standard",
            "payload": { "mobile_no": "13800138000" },
            "sourceCaseIds": ["mobile-no-valid"],
            "requiresBusinessReview": true
          }
        ],
        "coverageReport": {
          "selectedFieldCount": 1,
          "coveredFieldCount": 1,
          "caseCount": 1,
          "coverageLevel": "FIELD_ONLY",
          "missingConstraints": [],
          "unsupportedFields": []
        },
        "diagnostics": [],
        "safety": {
          "readOnly": true,
          "writesProject": false,
          "writesBusinessRepo": false,
          "containsRealBusinessRows": false,
          "externalNetworkUsed": false,
          "externalLlmUsed": false,
          "sensitiveInputCategories": ["standard-metadata"]
        },
        "nextActions": ["Review before using SQL seed drafts."]
      }
    },
    {
      "id": "consumer-compatibility-suite-minimal",
      "adapterId": "cli-json",
      "contractId": "consumer-compatibility-suite",
      "stableFields": ["kind", "schemaVersion", "suiteVersion", "minimumSupportedVersion", "status", "adapterResults", "diagnostics", "nextActions"],
      "payload": {
        "kind": "dataspec.consumer-compatibility-suite.check",
        "schemaVersion": 1,
        "suiteVersion": "2026.07.p6-test-data",
        "minimumSupportedVersion": "0.1.0",
        "status": "COMPATIBLE",
        "adapterResults": [],
        "diagnostics": [],
        "nextActions": ["Run consumer-compat check after contract changes."]
      }
    }
  ],
  "nextActions": [
    "Run node tools/dataspec-consumer-compat-check.mjs --format json after API, CLI, MCP, Schema Registry, or AI Context contract changes.",
    "Update golden payloads and migration notes when stable fields change."
  ]
}
